# ==============================================================================
# Speakaboo Production Environment Configuration (.env.production)
# ==============================================================================

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_DEBUG=false
SERVER_LOG_LEVEL=INFO
SECRET_KEY=CHANGE_THIS_TO_A_64_CHAR_HEX_ENTROPY_STRING

# AI Providers (Groq API Key - Required in Normal/Production Mode)
GROQ_API_KEY=your_live_production_groq_api_key_here

# Speech-To-Text (STT)
STT_PROVIDER=groq
STT_MODEL=whisper-large-v3-turbo

# Large Language Model (LLM)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.7

# Text-To-Speech (TTS)
TTS_PROVIDER=groq
TTS_MODEL=canopylabs/orpheus-v1-english
TTS_VOICE=austin

# Database Persistence
DATABASE_URL=sqlite:////app/data/speakaboo.db
DATABASE_PATH=/app/data/speakaboo.db

# Child Safety & Content Moderation
SAFETY_ENABLED=true

# Usage & Daily Practice Caps (Minutes)
FREE_DAILY_MINUTES=10
BASIC_DAILY_MINUTES=30
PREMIUM_DAILY_MINUTES=120

# Monetization & Payment Gateways (bKash & Nagad)
# In production, set PAYMENT_SANDBOX_MODE=false and provide live merchant credentials
PAYMENT_SANDBOX_MODE=true
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
NAGAD_MERCHANT_ID=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
MONTHLY_PLAN_PRICE_BDT=200
CHARACTER_UNLOCK_PRICE_BDT=350

