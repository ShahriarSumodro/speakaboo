# Speakaboo Backend Configuration
# Copy this file to .env and fill in your values

# === API Keys ===
GROQ_API_KEY=your_groq_api_key_here

# === Server ===
HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=info
TEST_MODE=false

# === STT Provider ===
STT_PROVIDER=groq
STT_MODEL=whisper-large-v3-turbo

# === LLM Provider ===
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile,llama-3.1-8b-instant
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.7

# === TTS Provider ===
TTS_PROVIDER=groq
TTS_MODEL=canopylabs/orpheus-v1-english
TTS_VOICE=austin

# === Safety ===
SAFETY_ENABLED=true

# === Usage Limits ===
FREE_DAILY_MINUTES=10
BASIC_DAILY_MINUTES=30
PREMIUM_DAILY_MINUTES=120

# === Database ===
DATABASE_URL=sqlite:///./speakaboo.db

# === Feature Flags ===
CONSTRUCTIVE_CRITICISM_MODE=false

# === Payments ===
PAYMENT_PROVIDER=mock
BKASH_MERCHANT_ID=
BKASH_API_KEY=
NAGAD_MERCHANT_ID=
NAGAD_API_KEY=

# === Pricing (BDT) ===
MONTHLY_PLAN_PRICE_BDT=200
CHARACTER_UNLOCK_PRICE_BDT=350
